{
  "manifest_version": 3,
  "name": "Voice Presentation",
  "version": "1.0.0",
  "description": "Captures audio from any browser tab, transcribes speech in real time, and generates live presentation slides.",

  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "tabs"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
